.DS_Store
_repo-root/
.gstack/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
_site/

# build intermediates and superseded deliverables (1.1GB, never commit)
tmp/
output/_archive/

# company originals: IR, revenue evidence, patents, MOUs. keep out of git
_originals/

# scripts/shots.py scratch dir — 스크립트는 #49 에서 삭제됐고, 남은 스크래치가
# 있는 클론을 위해 항목만 남긴다
.shots-tmp/

# build/ — 화면 빌드 산출물. 정본에서 언제든 다시 만들며 추적하지 않는다
# (정본 decided.REBUILD-FRAMEWORK: "생성물은 추적하거나 손으로 고치지 않는다")
build/

# humanize-korean 스킬 작업 폴더. 윤문 중간 산출물이고 저장소 것이 아니다
_workspace/

# scripts/generate_synthetic.py output — 약 160MB, 시드에서 재생성된다.
# 재현 증거는 scripts/synthetic-manifest.json 이고 그것만 git 에 있다 (ARTIFACTS.md).
.synthetic/

# scripts/build_pages_site.py 스테이징 — Pages 배포마다 다시 만들어진다
_site/

__pycache__/

# scripts/build_screens.py 산출물 — 정본에서 재생성된다
build/
