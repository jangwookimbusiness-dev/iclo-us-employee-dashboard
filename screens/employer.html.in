<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}}</title>
<!--
  Built by scripts/build_screens.py. Do not edit build/employer.html.

  Every number on this page comes from the CANON block below, which the builder
  writes out of contracts/proposal-package-v11.yml. Nothing here restates a
  constant. That is the whole point of the rebuild: the old screen declared the
  minimum cell size and the dependent ratio as literals copied by hand from the
  canon, so a check had to perturb those literals and re-render to prove they
  still agreed.

  This comment used to quote those two values. test_build_reads_canon.py caught
  it -- perturbing the canon left the old numbers sitting in the prose that
  explains why old numbers must not sit in prose. Do not name a canon value here.
  Name the concept and let the CANON block carry the number.

  The check did not go away, it moved. test_build_reads_canon.py perturbs the
  canon, runs this builder, and asserts the new value reached the output and the
  old one did not. Build-time reading removes the manual copy step only; a
  template or a label can still hold a stale value, which is exactly what codex
  pointed out about deleting that check outright.

  Two shapes of canon value appear below and the difference is not stylistic.
  A doubled-brace placeholder is filled by the builder; CANON.something is
  fetched by the browser. The split is only about reach: CSS custom properties
  and the <title> in <head> cannot fetch, so those get substitution. Everything
  a person reads as a measurement is fetched, because at A3 that file becomes a
  tenant export and this template must not change.

  Do not write a literal doubled-brace example in this comment. The builder
  refuses to emit an unsubstituted placeholder, and it does not know a comment
  from markup -- this paragraph cost one build to learn that.
-->
<style>
  :root{
    --ink:{{navy}}; --ink2:#5B6B85; --line:#E3E8F0; --panel:{{background}}; --ground:{{background}};
    --data:{{teal}}; --coral:{{coral}}; --field:#F7F8FA;
    --mono:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo","Noto Sans KR",Helvetica,Arial,sans-serif;
  }
  @media (prefers-color-scheme:dark){
    /* 다크 계열의 나머지는 정본이 정의하지 않으므로 템플릿 값으로 남는다. coral 만
       정본에 다크 값이 있고(colors.coral_dark_mode), 그것이 검사가 잡던 자리다 —
       라이트 정의 두 벌이 서로 다른 coral 을 쓰는 버그가 여기서 나왔다. */
    :root{--ink:#E7ECF5; --ink2:#95A2BE; --line:#28324C; --panel:#152038;
          --ground:#0E1526; --data:#3FB6C0; --coral:{{coral_dark}}; --field:#0F1930}
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);
       font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px}
  header{border-bottom:1px solid var(--line);background:var(--panel)}
  .hrow{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px;padding-block:14px}
  .logo{font-size:20px;font-weight:800;letter-spacing:-.02em}
  .sub{color:var(--ink2);font-size:13px}
  .pill{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--coral);
        border:1px solid var(--coral);border-radius:3px;padding:3px 8px}
  .ctx{background:var(--field);border-bottom:1px solid var(--line)}
  .ctxrow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding-block:10px}
  .freshness{font-family:var(--mono);font-size:11px;color:var(--ink2)}
  main{padding:22px 0}
  h2{margin:0 0 4px;font-size:17px}
  .lead{color:var(--ink2);margin:0 0 18px}
  .grid{display:grid;gap:0;border:1px solid var(--line);border-radius:4px;
        background:var(--panel);overflow:hidden;grid-template-columns:repeat(2,1fr)}
  @media(min-width:760px){.grid{grid-template-columns:repeat(5,1fr)}}
  .card{padding:14px 16px;border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .card:nth-child(-n+2){border-top:0}
  .card:nth-child(2n+1){border-left:0}
  @media(min-width:760px){
    .card{border-top:0}
    .card:nth-child(2n+1){border-left:1px solid var(--line)}
    .card:first-child{border-left:0}
    .card:last-child{background:var(--field)}
  }
  .lab{font-size:12px;color:var(--ink2)}
  .val{font-family:var(--mono);font-size:24px;margin-top:4px;line-height:1.15}
  .denom{font-size:12px;color:var(--ink2);margin-top:2px}
  .note{margin-top:20px;padding:12px 14px;border:1px solid var(--line);
        border-radius:4px;color:var(--ink2);font-size:13px}
  code{font-family:var(--mono);font-size:12px}
</style>
</head>
<body>
<header><div class="wrap"><div class="hrow">
  <span class="logo">{{title}}</span>
  <span class="pill">Synthetic data — illustrative only</span>
</div></div></header>

<div class="ctx"><div class="wrap"><div class="ctxrow">
  <span class="freshness" id="freshness">&mdash;</span>
</div></div></div>

<main class="wrap">
  <h2 id="heading">&mdash;</h2>
  <p class="lead">Rebuild skeleton. Every value and label below is read from the
  canon at build time; nothing on this page is a hand-copied constant.</p>

  <div class="grid" id="kpis"></div>

  <p class="note">Aggregate only. Cells covering fewer than
  <code id="mincell">—</code> distinct people are withheld, and the threshold in
  that sentence comes from the canon too — a regulatory number stated in prose is
  still a number that must not be typed twice.</p>
</main>

<script>
  // The screen fetches canon.json from its own directory. It holds no constant.
  // At A3 this same path serves a tenant export instead and the template does
  // not change -- that is why the decision record put the values in a sibling
  // file rather than inlining them here.
  fetch("./canon.json", {cache: "no-store"})
    .then(r => r.ok ? r.json() : Promise.reject(new Error("canon.json " + r.status)))
    .then(paint)
    .catch(e => {
      // Never fall back to plausible numbers. A blank screen with a reason is
      // recoverable; invented figures that look real are not.
      document.getElementById("kpis").innerHTML =
        '<div class="card"><div class="lab">Canon unavailable</div>' +
        '<div class="val">—</div><div class="denom">' + e.message + '</div></div>';
    });

function paint(CANON){
  const pct = f => Math.round(f * 100) + "%";
  const fmt = n => n.toLocaleString("en-US");
  const esc = s => String(s).replace(/[&<>"]/g, c =>
    ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

  // Baseline scenario for the skeleton. Scenario switching returns with the
  // export wiring; hardcoding a picker now would be a second place to maintain.
  const scen = CANON.scenarios[0];
  const members = Math.round(scen.employees * CANON.dep_ratio);

  // Value and denominator per card key. The LABEL is not here -- it comes from
  // CANON.cards, because the first draft typed all five labels into this array
  // and three of them existed nowhere in the canon. They had been copied off the
  // old screen, so the canon and two screens disagreed and no check compared
  // them: check_dashboard only ever asked whether canon labels reached the
  // screen, never whether screen labels came from the canon.
  //
  // The denominator strings stay template prose. They carry no number, so they
  // cannot go stale the way a label carrying a value can. repeat's denominator
  // is the exception and it is already canon-owned -- it is a definition that
  // changed once and left the screen behind.
  const wired = {
    eligible_employees:   [fmt(scen.employees), "funnel denominator"],
    covered_members:      [fmt(members), "cost denominator (member-months)"],
    activated:            [pct(CANON.activated), "of eligible employees"],
    repeat_participation: [pct(CANON.repeat), CANON.repeat_denominator],
    pmpm_allowed:         ["$" + scen.pmpm.toFixed(2), "per covered member-month"],
  };

  document.getElementById("heading").textContent = CANON.heading;

  document.getElementById("kpis").innerHTML = CANON.cards.map(card => {
    // A canon card with no value wired here says so on the screen. Silently
    // dropping it would let the contract grow a card nobody notices is blank.
    const [val, denom] = wired[card.key] ||
      ["—", "no value wired for " + card.key];
    return `<div class="card"><div class="lab">${esc(card.label)}</div>` +
      `<div class="val">${esc(val)}</div>` +
      `<div class="denom">${esc(denom)}</div></div>`;
  }).join("");

  // The regulatory sentence carries the threshold, and it comes from the same
  // place. A number stated in prose is still a number that must not be typed twice.
  document.getElementById("mincell").textContent = CANON.min_cell;

  // Data currency, per source. Delivery freshness and data freshness are
  // different things and mixing them lets a just-built page look healthy on top
  // of six-month-old claims, so each source states its own through-date.
  document.getElementById("freshness").textContent =
    `eligibility through ${CANON.eligibility_thru} · ` +
    `claims through ${CANON.claims_thru} · ` +
    `lag ${CANON.lag_days}d · ` +
    `completeness ${CANON.completeness_pct}%`;
}
</script>
</body>
</html>
