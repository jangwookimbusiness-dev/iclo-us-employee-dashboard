# 대시보드 화면 — 코드에 있는 문자열이 정본이다
# 문서가 대시보드를 설명할 때 이 이름을 그대로 써야 대응이 된다
# ─────────────────────────────────────────────────────────────
dashboard:
  title: ICLO HomeDen Employer Analytics
  tabs:                     # index.html TABS 상수와 1:1
    - key: overview
      label: Overview
      heading: Program overview
    - key: signals
      label: Signals
      heading: Oral-health signal distribution
    - key: funnel
      label: Funnel
      heading: Intervention funnel
  views_deferred:
    - name: Preventive-visit Trend vs Control
      reason: 실험군 배정에 동의 근거·배정 규칙·프로토콜 책임자가 없다
      returns_when: 법무·프로토콜 승인 후
      note: PRD 원안의 4번째 뷰. 의도적 보류이며 미구현이 아니다.

  kpis:                     # 화면 라벨 = 정본. 문서는 이 문자열을 쓴다.
    - label: Eligible employees
      const: null
      definition_ko: 기준 시점에 플랜 자격이 있는 임직원 수
      source: HRIS · 834 eligibility
    - label: Activated (registered + first questionnaire)
      const: FRAC.activated
      value: 0.38
      definition_ko: 가입 + 첫 문진 완료 / 자격자
      source: App · consent + events
    - label: Valid capture (passed photo-quality gate)
      const: FRAC.valid
      value: 0.28
      definition_ko: 품질 게이트를 통과한 촬영
      source: App · photo-derived signals (versioned)
      gap: 기술문서 §3 화면 지표표에 이 항목이 없다 — 추가해야 한다
    - label: Open care actions
      const: FRAC.gap
      value: 0.095
      definition_ko: 발생한 조치
      source: App events + TPA claims-confirmed
    - label: Completed actions
      const: FRAC.closed
      value: 0.042
      definition_ko: 청구로 확인된 완료 (confidence HIGH 만)
      source: App events + TPA claims-confirmed

  repeat_participation:
    const: FRAC.repeat
    value: 0.61
    definition_ko: 2회 이상 유효 촬영한 사람 / 활성 사용자

  signals:                  # PRD §4b 5항과 index.html SIGNALS 가 일치해야 한다
    - {key: Low,      share: 52}
    - {key: Moderate, share: 33}
    - {key: Priority, share: 15}

  scenarios:                # PRD §2, index.html SCEN, 기술문서 §14.4 세 곳 일치
    - {key: A, employees: 10000, pmpm: 31.4, label: baseline}
    - {key: B, employees: 2500,  pmpm: 32.8, label: small}
    - {key: C, employees: 25000, pmpm: 30.9, label: large}

  constants:
    min_cell: 20            # 기업 화면 최소 셀. 기술문서 가정 A8, PRD 레드라인
    dep_ratio: 2.2          # 자격자당 가입 인원. 기술문서 "member_month 약 22,000행" 과 정합
    lag_days: 60            # 데모 표시값. 실제는 분포(중앙값 45·롱테일 180) — 기술문서 §6.3
    completeness_pct: 98.4  # 합성 데모 값. 실데이터에서는 지연 곡선 출처를 밝혀야 한다
    eligibility_thru: "2026-07"
    claims_thru: "2026-05"

  # 부스 라이브 캡처 (SWT Seoul 2026-08-27). PRD §2.1·§3.5
  booth:
    employer_key: LIVE
    label: "Snowflake World Tour Seoul · live capture"
    seed_members: 120       # 08:00 에 Low·Moderate 는 보이고 Priority 는 억제되는 크기.
                            # 실촬영은 하루 수십 건 규모로 잡는다 (3,000 참석자 ≠ 3,000 촬영).
    refresh:                # 화면 요소마다 민감도가 다르므로 갱신 주기를 가른다 (PRD §5.8)
      live: [participation_count]
      # 참여 수는 밴드를 안 싣는다. 부스에서 촬영한 사실 자체는 이미 눈에 보인다.
      # 찍자마자 올라가야 방문자가 "들어갔다"를 안다.
      batched: [signal_distribution, band_derived_figures]
      batch_size: 5         # 밴드를 싣는 것은 신규 5건이 쌓여야 다시 그린다. 1건마다 갱신하면
                            # 방금 촬영한 사람의 밴드가 화면 변화로 새어나간다.
                            # 튜닝 값이 아니라 레드라인이다.
    own_device: 본인 폰에는 자기 밴드 + 합류한 집계 + "N명 중 한 명" 까지 즉시 표시. 유출 아님.
    seed_signals: {Low: 52, Moderate: 33, Priority: 15}   # A/B/C 와 같은 시작 분포
    real_fields: [signal_band, captured_at, model_version]
    synthetic_fields: [department, tenure_band, eligibility_span, claim_lines]
    never_stored: [oral_image, badge_plaintext, badge_decoded_fields]
    badge:                  # 명찰 QR = 자격 확인 단계. 기술문서 §4 의 SSN 규칙과 동일하게 다룬다.
      use: 읽는 즉시 HMAC, 평문은 메모리에서 폐기. 해시만 저장.
      why_hash: 같은 사람 중복 촬영 탐지. 해시로는 이름을 되찾을 수 없다.
      unknown: SWT 명찰 QR 이 vCard 인지 불투명 ID 인지 미확인 — 8/14 까지 Snowflake 에 확인 (PRD §5.9)
    contact:                # 연락처는 촬영과 절대 이어붙지 않는다
      table: 별도
      timestamp: 날짜까지만   # 초 단위면 테이블이 달라도 시각으로 조인된다
      join_to_capture: 없음
    output: band            # LOW | MODERATE | PRIORITY. 숫자 점수 금지 —
                            # 재식별이 쉬워지고 의료기기 경계에 가까워진다.
    row_shape: employer_id · captured_at · signal_band · model_version · 합성 컨텍스트
    label_rule: |
      A/B/C 는 "Synthetic data — illustrative only" 를 그대로 쓴다.
      부스 기업은 필드별로 표시한다 — 신호는 실촬영, 급여 맥락은 합성.
      부스 기업 전체를 합성이라고도, 실데이터라고도 부르지 않는다.
    suppression: A/B/C 와 동일하게 n≥20 적용. 부스라고 완화하지 않는다.
    individual_visibility: 본인 기기에만. 부스 화면 DOM 에는 어떤 시점에도 개인이 없다.

  colors:                   # PRD §3·§5.6 레드라인
    coral: "#C2333A"        # 원안 #FF7A79 는 흰 배경에서 2.53:1 로 WCAG AA 미달이었다.
                            # 2026-08-08 design review 에서 5.49:1 로 교체. PRD 갱신 완료.
    coral_dark_mode: "#FF8E8D"
    bars:                   # WCAG 1.4.11 — 의미를 싣는 비텍스트는 3:1. 서열은 휘도로 유지.
      light: {Low: "#7E90AE", Moderate: "#4E8F98", Priority: "#C2333A"}   # 3.05 / 3.46 / 5.16
      dark:  {Low: "#5B7099", Moderate: "#4FA0A9", Priority: "#FF8E8D"}   # 3.51 / 5.77 / 7.91
      was: 원래 #D9E1EE / #8FB8BE 는 1.24 / 2.02 로, 데이터의 53% 를 싣는 Low 가 안 보였다.
    navy: "#1B2A4A"
    teal: "#007A87"
    background: "#FFFFFF"
    rule: 라이트 계열 정의(:root 와 :root[data-theme="light"])는 같은 coral 을 써야 한다

  implementation:
    actual: 단일 vanilla HTML + 인라인 CSS/JS (index.html), 촬영 앱은 capture.html
    store: Supabase 단일 테이블 + realtime 구독 (insert 전용 RLS)
    inference: ICLO Core AI POST /v1/oral-signal — 호출 후 이미지 즉시 폐기
    freeze: 2026-08-25
    event: Snowflake World Tour Seoul · COEX · 2026-08-27
    booth_device: iPad Pro 12.9인치 가로 (1366×1024). Overview 가 934px 라 들어간다.
    touch: 모든 컨트롤 44px 무조건. hover:none 게이트는 키보드 붙은 iPad 에서 안 걸린다.
    chips: 탭하면 적재 경로가 열린다. title 전용이면 태블릿에서 그 정보가 없는 것과 같다.
    not: Vite + React 18 + TypeScript + Tailwind + Recharts
    note: PRD 원안 스택은 미채택. package.json·src·dist 없음. AGENTS.md 의 npm 명령은 실행 불가.

# ─────────────────────────────────────────────────────────────
# 절대 표현 — 범위를 좁히지 않으면 사실과 다른 주장이 된다
# ─────────────────────────────────────────────────────────────
scoped_claims:
  - wrong: "no individual PHI"
    right: "no individual PHI in employer views"
    why: 가입자-월·청구 항목은 개인 단위 레코드 없이 계산할 수 없다. 관리형 처리 레이어에는 개인 레벨 데이터가 존재한다. 통제 대상은 데이터의 존재가 아니라 열람 권한이다. (기술문서 §2.1)
  - wrong: "집계만, 개인정보 없음"
    right: "집계 전용 · 최소 셀은 고유 인물 기준 · 기업 격리"
    why: MIN_GROUP_SIZE 는 기본적으로 행 수를 센다. ENTITY KEY (party_sk) 가 있어야 고유 인물 수로 센다. (기술문서 §10.3)
  - wrong: "실험군 배정 + 청구로 확인한 결과"
    right: "청구로 확인한 결과 (실험군 배정은 법무·프로토콜 승인 후)"
    why: 배정 규칙·동의 근거·프로토콜 책임자가 없다

# ─────────────────────────────────────────────────────────────
# 용어 — 좌변을 쓰면 안 되고 우변을 쓴다
# ─────────────────────────────────────────────────────────────
terminology:
  forbidden:
    - {wrong: "보험자 지급액",  right: "플랜 지급액",  why: self-funded 에서 돈을 내는 주체는 기업이지 보험사가 아니다}
    - {wrong: "보험사가 지급",  right: "플랜이 지급",  why: 같음}
    - {wrong: "HRIS 834",      right: "기업 또는 benefits administrator 가 제공하는 자격 파일, 통상 X12 834", why: 834 를 HRIS 가 직접 뱉는 것이 아니다}
    - {wrong: "Review",        right: "Priority",     why: PRD 레드라인. 신호 라벨}
  disease_words_banned:      # PRD §5.6 · scripts/check-forbidden-terms.sh
    [diagnos, cavit, caries, decay, gingivit, periodont, abscess, lesion]
  pairs:                     # 두 개념을 섞어 쓰지 않는다
    - payer / carrier:  payer 는 비용 부담 주체(self-funded 는 기업), carrier 는 보험 상품 제공자
    - self-funded / ASO / stop-loss:  셋을 세트로 표기한다
    - plan_paid / allowed / member_oop:  합치지 않고 분리해서 저장·표시한다
  ko_en:
    플랜 지급액: plan-paid
    허용액: allowed
    본인부담: member out-of-pocket
    자격 파일: eligibility file
    청구 지연: claims lag
    최소 셀: minimum cell size
    가입자-월: member-month

# ─────────────────────────────────────────────────────────────
# 착수 게이트 — 실데이터 적재 전에 서면으로 닫아야 하는 넷
# 대외 문서(Report EN · Proposal EN)에 반드시 노출한다
# ─────────────────────────────────────────────────────────────
start_gates:
  - id: hipaa_roles
    ko: HIPAA 역할 규정
    en: HIPAA roles
    what: ICLO·기업·기업 건강플랜·TPA·Snowflake 각각이 covered entity / business associate / subcontractor 중 무엇인가. BAA 체인은 이 판정 위에 세운다.
    if_open: PHI 를 적재할 법적 근거가 없다
  - id: data_rights
    ko: 데이터 권리
    en: Data rights
    what: 기업–TPA 계약의 데이터 권리 조항 — 원천별·필드별·목적별로 무엇을 받고 무엇에 쓸 수 있는가
    if_open: 데이터를 받고도 쓸 수 없다. 지연의 대부분이 여기서 생긴다.
  - id: baseline_before_consent
